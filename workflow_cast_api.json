{
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "Load Krea 2 DiT" },
    "inputs": {
      "unet_name": "krea2_raw_bf16.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "Load Krea 2 Text Encoder" },
    "inputs": {
      "clip_name": "qwen3vl_4b_fp8_scaled.safetensors",
      "type": "krea2"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": { "title": "Load Krea 2 VAE" },
    "inputs": {
      "vae_name": "qwen_image_vae.safetensors"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Cast Portrait Prompt" },
    "inputs": {
      "text": "",
      "clip": ["2", 0]
    }
  },
  "5": {
    "class_type": "ConditioningZeroOut",
    "_meta": { "title": "Zeroed Negative" },
    "inputs": {
      "conditioning": ["4", 0]
    }
  },
  "6": {
    "class_type": "EmptyLatentImage",
    "_meta": { "title": "Portrait Canvas" },
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    }
  },
  "7": {
    "class_type": "KSampler",
    "_meta": { "title": "Sample Cast Anchor" },
    "inputs": {
      "model": ["1", 0],
      "positive": ["4", 0],
      "negative": ["5", 0],
      "latent_image": ["6", 0],
      "seed": 0,
      "steps": 28,
      "cfg": 4.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "_meta": { "title": "Decode Portrait" },
    "inputs": {
      "samples": ["7", 0],
      "vae": ["3", 0]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "_meta": { "title": "Save Cast Anchor" },
    "inputs": {
      "images": ["8", 0],
      "filename_prefix": "mvm_cast_anchor"
    }
  }
}
